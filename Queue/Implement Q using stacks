#include <iostream>
#include <stack>
using namespace std;

class QueueUsingstack {
    stack<int> s1, s2;

public:
    // enqueue
    void push(int data) {
        s1.push(data);
    }

    // dequeue
    void pop() {
        if (s1.empty() && s2.empty()) {
            cout << "Queue is underflow\n";
            return;
        }

        if (s2.empty()) {
            while (!s1.empty()) {
                s2.push(s1.top());
                s1.pop();
            }
        }

        cout << s2.top() << endl;
        s2.pop();
    }



    
    // front
    int front() {
        if (s1.empty() && s2.empty()) {
            cout << "Queue is empty\n";
            return -1;
        }

        if (s2.empty()) {
            while (!s1.empty()) {
                s2.push(s1.top());
                s1.pop();
            }
        }

        return s2.top();
    }
};

int main() {
    QueueUsingstack q;

    q.push(1);
    q.push(2);
    q.push(3);
    q.push(4);
    q.push(5);

    cout << q.front() << endl; // 1
    q.pop();                   // 1 removed
    cout << q.front() << endl; // 2
}