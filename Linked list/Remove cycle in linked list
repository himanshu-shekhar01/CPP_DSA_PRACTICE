
#include <iostream>
using namespace std;

class Node{
    public:
    int data;
    Node* next;
    Node(int x){
        data = x;
        next = NULL;
    }
};

void removeLoop(Node* head){
    Node* slow = head;
    Node* fast = head;
    bool loopExists = false;
    while(fast&&fast->next){
        slow = slow->next;
        fast = fast->next->next;
        if(slow==fast){
            loopExists = true;
            break;
        }
    }
    if(!loopExists) return;
    
    // count no of nodes in cycle for remove cycle
    int k = 1;
    Node* temp = slow;
    while(temp->next!=slow){
        k++;
        temp = temp->next;
    }
    
    Node* ptr1 = head;
    Node* ptr2 = head;
    for(int i=0;i<k;i++){
        ptr2 = ptr2->next;
    }
    
    while(ptr1!=ptr2){
        ptr1 = ptr1->next;
        ptr2 = ptr2->next;
    }
    
     // ptr1 is start of loop
    Node* last = ptr1;
    while(last->next != ptr1) {
        last = last->next;
    }
    last->next = NULL;
}

void printList(Node* head) {
    while(head) {
        cout << head->data << " ";
        head = head->next;
    }
}

int main() {
    Node* head = new Node(1);
    head->next = new Node(2);
    head->next->next = new Node(3);
    head->next->next->next = new Node(4);
    head->next->next->next->next = new Node(5);

    // Create loop: 5 -> 3
    head->next->next->next->next->next = head->next->next;

    removeLoop(head);

    printList(head);

    return 0;
}

